// --------- Chat: basic local echo (so it feels alive) ---------
const chatInput = document.getElementById("chat-input");
const chatSendBtn = document.getElementById("chat-send-btn");
const chatMessages = document.getElementById("chat-messages");
const chatThinking = document.getElementById("chat-thinking-status");

function appendMessage(text, who) {
  if (!chatMessages || !text.trim()) return;
  const msg = document.createElement("div");
  msg.className = `chat-message ${who}`;
  msg.textContent = text.trim();
  chatMessages.appendChild(msg);
  chatMessages.scrollTop = chatMessages.scrollHeight;
}

function fakeAIReply(userText) {
  if (!chatThinking) return;
  chatThinking.classList.remove("hidden");
  setTimeout(() => {
    chatThinking.classList.add("hidden");
    appendMessage("NYVRON noted this. (Local echo, no backend yet.)", "ai");
  }, 800);
}

function sendChat() {
  if (!chatInput) return;
  const value = chatInput.value;
  if (!value.trim()) return;
  appendMessage(value, "user");
  chatInput.value = "";
  fakeAIReply(value);
}

if (chatSendBtn && chatInput) {
  chatSendBtn.addEventListener("click", sendChat);
  chatInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendChat();
    }
  });
}

