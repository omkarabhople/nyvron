// --------- Command bar / Search button ---------
const commandBar = document.getElementById("commandbar");
const commandBarTrigger = document.getElementById("commandbar-trigger");
const commandBarInput = document.getElementById("commandbar-input");

function openCommandBar() {
  if (!commandBar) return;
  commandBar.classList.remove("hidden");
  commandBar.setAttribute("aria-hidden", "false");
  if (commandBarInput) {
    commandBarInput.value = "";
    commandBarInput.focus();
  }
}

function closeCommandBar() {
  if (!commandBar) return;
  commandBar.classList.add("hidden");
  commandBar.setAttribute("aria-hidden", "true");
}

if (commandBarTrigger) {
  commandBarTrigger.addEventListener("click", () => {
    openCommandBar();
  });
}

// Keyboard shortcuts: ⌘K / Ctrl+K to open, Esc to close
document.addEventListener("keydown", (e) => {
  const key = e.key.toLowerCase();
  if ((e.metaKey || e.ctrlKey) && key === "k") {
    e.preventDefault();
    openCommandBar();
  }
  if (key === "escape") {
    closeCommandBar();
  }
});

// Close if clicking backdrop
if (commandBar) {
  commandBar.addEventListener("click", (e) => {
    if (e.target.classList.contains("commandbar-backdrop")) {
      closeCommandBar();
    }
  });
}

// --------- Today: greeting + energy buttons ---------
function updateGreeting() {
  const greetingEl = document.getElementById("today-greeting");
  const subtitleEl = document.getElementById("today-subtitle");
  const dashboardGreeting = document.getElementById("dashboard-greeting");

  const now = new Date();
  const hour = now.getHours();
  let greeting = "HELLO! SIR!";
  let line = "Let’s build your empire.";

  if (hour < 12) {
    greeting = "GOOD MORNING";
    line = "Start your day with intent.";
  } else if (hour < 18) {
    greeting = "GOOD AFTERNOON";
    line = "Keep your momentum going.";
  } else {
    greeting = "GOOD EVENING";
    line = "Reflect and reset for tomorrow.";
  }

  if (greetingEl) greetingEl.textContent = greeting;
  if (subtitleEl) subtitleEl.textContent = line;
  if (dashboardGreeting) dashboardGreeting.textContent = greeting;
}
updateGreeting();

