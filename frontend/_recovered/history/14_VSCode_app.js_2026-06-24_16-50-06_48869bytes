// Countdowns (linked to Calendar events or manual)

function formatCountdownDiff(targetDate) {
  const now = new Date();
  const diffMs = targetDate.getTime() - now.getTime();
  const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
  if (diffDays > 0) return `${diffDays} day${diffDays === 1 ? "" : "s"} remaining`;
  if (diffDays === 0) return "Today";
  return `${Math.abs(diffDays)} day${Math.abs(diffDays) === 1 ? "" : "s"} ago`;
}

function renderCountdown() {
  if (!countdownLabelEl || !countdownTimeEl || !countdownMetaEl) return;

  if (!todayState.countdowns.length) {
    countdownLabelEl.textContent = "No countdown set.";
    countdownTimeEl.textContent = "";
    countdownMetaEl.textContent = "";
    return;
  }

  const next = todayState.countdowns[0];
  const dtString = `${next.date}T${next.time || "00:00"}`;
  const targetDate = new Date(dtString);
  countdownLabelEl.textContent = next.title;
  countdownTimeEl.textContent = formatCountdownDiff(targetDate);
  countdownMetaEl.textContent =
    `${next.date} ${next.time || ""}` +
    (next.notes ? ` · ${next.notes}` : "");
}

if (countdownSetBtn) {
  countdownSetBtn.addEventListener("click", () => {
    const title = prompt("Countdown title");
    if (!title || !title.trim()) return;
    const date = prompt("Target date (YYYY-MM-DD)");
    if (!date || !date.trim()) return;
    const time = prompt("Target time (HH:MM, optional)") || "";
    const notes = prompt("Notes (optional)") || "";
    const id = Date.now();
    todayState.countdowns = [
      {
        id,
        title: title.trim(),
        date: date.trim(),
        time: time.trim(),
        notes: notes.trim(),
      },
    ];
    saveJSON("nyvron_today", todayState);
    renderCountdown();
  });
}

