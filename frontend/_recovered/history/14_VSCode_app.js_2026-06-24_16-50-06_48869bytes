// =========================
// Command bar
// =========================

function openCommandBar() {
  if (!commandbar) return;
  commandbar.classList.remove("hidden");
  if (commandbarInput) {
    commandbarInput.value = "";
    commandbarInput.focus();
  }
}

function closeCommandBar() {
  if (!commandbar) return;
  commandbar.classList.add("hidden");
}

if (commandbarTrigger) {
  commandbarTrigger.addEventListener("click", openCommandBar);
}

if (commandbarInput) {
  commandbarInput.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeCommandBar();
      return;
    }
    if (e.key === "Enter") {
      const value = commandbarInput.value.trim().toLowerCase();
      if (!value) return;
      if (value.startsWith("today")) setActiveScreen("screen-today");
      else if (value.startsWith("dash"))
        setActiveScreen("screen-dashboard");
      else if (value.startsWith("chat"))
        setActiveScreen("screen-chat");
      else if (value.startsWith("cal"))
        setActiveScreen("screen-calendar");
      else if (value.startsWith("time"))
        setActiveScreen("screen-time");
      else if (value.startsWith("sched"))
        setActiveScreen("screen-schedule");
      else if (value.startsWith("mem"))
        setActiveScreen("screen-memory");
      else if (value.startsWith("ref"))
        setActiveScreen("screen-reflection");
      else if (value.startsWith("profile"))
        setActiveScreen("screen-profile");
      else if (value.startsWith("set"))
        setActiveScreen("screen-settings");
      closeCommandBar();
    }
  });
}

document.addEventListener("keydown", (e) => {
  if (e.key === "k" && (e.metaKey || e.ctrlKey)) {
    e.preventDefault();
    if (commandbar && commandbar.classList.contains("hidden"))
      openCommandBar();
    else closeCommandBar();
  }
});

