/* =========================
   Base and layout
   ========================= */

:root {
  --nyvron-font-scale: 1;
  --nyvron-bg: radial-gradient(circle at top, #020617 0, #000 55%);
  --nyvron-card-bg: rgba(15, 23, 42, 0.85);
  --nyvron-border: rgba(148, 163, 184, 0.45);
  --nyvron-border-soft: rgba(148, 163, 184, 0.25);
  --nyvron-highlight: rgba(56, 189, 248, 1);
  --nyvron-highlight-soft: rgba(56, 189, 248, 0.2);
  --nyvron-text-main: #e5e7eb;
  --nyvron-text-muted: #9ca3af;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
}

body {
  font-size: calc(14px * var(--nyvron-font-scale, 1));
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
    -apple-system, sans-serif;
  background: var(--nyvron-bg);
  color: var(--nyvron-text-main);
}

/* App shell */

.app {
  display: flex;
  min-height: 100vh;
}

/* Sidebar universal on desktop */

.sidebar {
  width: 260px;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  padding: 16px 16px 20px;
  overflow-y: auto;
}

/* Sidebar styling */

.glass-sidebar {
  background: transparent;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.logo {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at top left, #22d3ee, #0f172a);
  color: #f9fafb;
  font-weight: 600;
}

.brand-text .name {
  font-size: 14px;
  font-weight: 600;
}

.brand-text .subtext {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 8px;
}

.sidebar-section-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--nyvron-text-muted);
  margin: 10px 0 4px;
}

/* Nav buttons */

.nav-item {
  width: 100%;
  justify-content: flex-start;
}

.nav-item .icon {
  width: 20px;
}

/* Sidebar footer */

.sidebar-footer {
  margin-top: 16px;
  font-size: 11px;
}

.status {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-indicator {
  position: relative;
  width: 16px;
  height: 16px;
}

.status-dot,
.status-ring {
  position: absolute;
  inset: 0;
  border-radius: 999px;
}

.status-dot {
  margin: 4px;
  background: #22c55e;
  box-shadow: 0 0 10px #22c55e;
}

.status-ring {
  border: 1px solid rgba(34, 197, 94, 0.6);
  animation: status-pulse 1.4s infinite ease-out;
}

@keyframes status-pulse {
  0% {
    transform: scale(0.9);
    opacity: 1;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

/* Main panel */

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* Topbar */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  gap: 16px;
  margin: 12px 20px 0;
}

.topbar-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.topbar-title {
  font-size: 18px;
  font-weight: 600;
}

.topbar-subtitle {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

.topbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.topbar-clock {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.topbar-clock-time {
  font-size: 14px;
  font-weight: 500;
}

.topbar-clock-zone {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Screens container */

.screens {
  flex: 1;
  overflow-y: auto;
  padding: 20px 20px 80px;
}

/* Screens */

.screen {
  display: none;
}

.screen.active {
  display: block;
}

.screen-inner {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Glass cards */

.glass-card {
  border-radius: 16px;
  background:
    radial-gradient(
        circle at top left,
        rgba(148, 163, 184, 0.16),
        transparent
      )
      border-box,
    var(--nyvron-card-bg);
  border: 1px solid var(--nyvron-border);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
  padding: 14px 16px;
}

/* Card header/body */

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}

.card-title {
  font-size: 14px;
  font-weight: 600;
}

.card-subtitle {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Buttons / chips / nav items */

.glass-button,
.glass-chip,
.nav-item,
.bottom-nav-item {
  border-radius: 999px;
  border: 1px solid var(--nyvron-border-soft);
  background: rgba(15, 23, 42, 0.85);
  color: var(--nyvron-text-main);
  font-size: 12px;
  padding: 6px 10px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition:
    background 0.18s ease,
    transform 0.12s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.glass-chip {
  padding: 5px 10px;
}

.glass-button:hover,
.glass-chip:hover,
.nav-item:hover,
.bottom-nav-item:hover {
  background: var(--nyvron-highlight-soft);
  border-color: rgba(56, 189, 248, 0.7);
  box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.4);
}

.glass-button:active,
.glass-chip:active,
.nav-item:active,
.bottom-nav-item:active {
  transform: scale(0.96);
  background: rgba(56, 189, 248, 0.28);
}

.nav-item.active,
.bottom-nav-item.active {
  background: linear-gradient(
    120deg,
    rgba(56, 189, 248, 0.25),
    rgba(129, 140, 248, 0.3)
  );
  border-color: rgba(56, 189, 248, 0.9);
}

/* Form fields */

.field,
.field-inline {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
}

.field-inline {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

.field-input {
  border-radius: 10px;
  border: 1px solid var(--nyvron-border-soft);
  background: rgba(15, 23, 42, 0.9);
  color: var(--nyvron-text-main);
  padding: 6px 10px;
  font-size: 12px;
}

.field-input:focus {
  outline: none;
  border-color: rgba(56, 189, 248, 0.7);
}

.field-help {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

/* Checklists / lists */

.checklist,
.schedule-list,
.sessions-list,
.memory-list,
.calendar-events-list,
.reflection-list,
.notifications-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* Offline badge */

.offline-badge {
  margin: 10px 20px 0;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.hidden {
  display: none !important;
}

/* =========================
   Today & Dashboard
   ========================= */

.today-header,
.dashboard-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.today-header-main,
.dashboard-header-main {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.today-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid var(--nyvron-border-soft);
  background: rgba(15, 23, 42, 0.8);
  font-size: 11px;
}

.status-ellipse {
  width: 18px;
  height: 18px;
  border-radius: 999px;
  border: 1px solid rgba(34, 197, 94, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-dot-green {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #22c55e;
  box-shadow: 0 0 8px #22c55e;
}

.today-greeting {
  font-size: 22px;
  margin: 0;
}

.today-subtitle {
  font-size: 12px;
  color: var(--nyvron-text-muted);
  margin: 0;
}

.today-header-time,
.dashboard-header-time {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  font-size: 12px;
}

.today-time-display {
  font-size: 20px;
  font-weight: 600;
}

.today-timezone,
.today-date,
.dashboard-date,
.dashboard-time-label {
  font-size: 11px;
  color: var(--nyvron-text-muted);
}

/* Today grid */

.today-grid,
.dashboard-grid {
  display: grid;
  gap: 18px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

/* Energy selector */

.today-energy-row,
.today-mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.today-energy-label,
.today-label {
  font-size: 12px;
  color: var(--nyvron-text-muted);
}

.energy-selector {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.energy-btn.active {
  background: var(--nyvron-highlight-soft);
  border-color: var(--nyvron-highlight);
}

/* Low energy banner */

.low-energy-banner {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  font-size: 11px;
}

.low-energy-dismiss {
  border: none;
  background: transparent;
  color: var(--nyvron-highlight);
  cursor: pointer;
}

/* Today checklist / quick notes */

.list-section-label {
  font-size: 11px;
  color: var(--nyvron-text-muted);
  margin-top: 4px;
}

.quick-notes-input {
  width: 100%;
  min-height: 80px;
  border-radius: 10px;
  border: 1px solid var(--nyvron-border-soft);
  background: rgba(15, 23, 42, 0.95);
  color: var(--nyvron-text-main);
  padding: 8px 10px;
  font-size: 12px;
}

/* Dashboard */

.focus-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* Progress chart placeholder */

.progress-chart {
  height: 140px;
  border-radius: 12px;
  border: 1px dashed var(--nyvron-border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--nyvron-text-muted);
}

/* =========================
   Chat
   ========================= */

.chat-layout {
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(260px, 1fr);
  gap: 16px;
}

.chat-main {
  display: flex;
  flex-direction: column;
  min-height: 360px;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Simple message style (placeholder) */
.chat-message {
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 11px;
  max-width: 75%;
}

.chat-message.user {
  align-self: flex-end;
  background: rgba(56, 189, 248, 0.3);
}

.chat-message.ai {
  align-self: flex-start;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--nyvron-border-soft);
}

/* Typing bar fixed at bottom inside card */

.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-top: 1px solid var(--nyvron-border-soft);
  background: rgba(15, 23, 42, 0.95);
  border-radius: 0 0 16px 16px;
  position: sticky;
  bottom: 0;
}

.chat-input {
  flex: 1;
  resize: none;
  border: none;
  outline: none;
  background: transparent;
  color: inherit;
}

.chat-side {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Thinking indicator */

.chat-thinking {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  font-size: 11px;
}

.chat-thinking .dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: var(--nyvron-highlight);
  animation: typing-bounce 1s infinite ease-in-out;
}

.chat-thinking .dot-2 {
  animation-delay: 0.12s;
}
.chat-thinking .dot-3 {
  animation-delay: 0.24s;
}

@keyframes typing-bounce {
  0%,
  80%,
  100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-3px);
  }
}

/* =========================
   Calendar
   ========================= */

.calendar-layout {
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(260px, 1fr);
  gap: 16px;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  font-size: 11px;
  text-align: center;
  margin-top: 8px;
  color: var(--nyvron-text-muted);
}

.calendar-days-grid {
  margin-top: 6px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  font-size: 11px;
}

.calendar-day {
  height: 38px;
  border-radius: 8px;
  border: 1px solid rgba(30, 64, 175, 0.3);
  background: rgba(15, 23, 42, 0.9);
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 4px 6px;
  cursor: pointer;
  transition: border 0.15s ease, background 0.15s ease;
}

.calendar-day:hover {
  border-color: rgba(56, 189, 248, 0.8);
}

.calendar-day.selected {
  border-color: var(--nyvron-highlight);
  background: rgba(56, 189, 248, 0.15);
}

/* Modal */

.modal {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.75);
}

.modal-dialog {
  position: relative;
  z-index: 10;
  max-width: 420px;
  width: 100%;
}

.modal-close-btn {
  border: none;
  background: transparent;
  color: var(--nyvron-text-muted);
  cursor: pointer;
}

/* =========================
   Time tracker
   ========================= */

.time-layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 18px;
}

.timer-display {
  font-size: 32px;
  letter-spacing: 0.08em;
  text-align: center;
  margin-bottom: 10px;
}

.timer-controls {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 10px;
}

.timer-modes {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mode-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.timer-tags {
  margin-top: 6px;
}

/* =========================
   Schedule
   ========================= */

.schedule-layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
}

/* =========================
   Memory / Reflection / Profile / Settings / Notifications
   ========================= */

.memory-layout,
.reflection-layout,
.profile-layout,
.settings-layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
}

.profile-avatar-circle {
  width: 64px;
  height: 64px;
  border-radius: 999px;
  background: radial-gradient(circle at top, #22d3ee, #0f172a);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

/* Notifications */

.notifications-layout {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Settings */

.settings-language-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.india-map-icon {
  font-size: 20px;
}

.destructive {
  border-color: rgba(220, 38, 38, 0.7);
  color: #fecaca;
}

/* =========================
   Bottom nav & command bar
   ========================= */

.bottom-nav {
  display: none;
}

.bottom-nav-item {
  flex-direction: column;
  padding: 4px 10px;
  font-size: 11px;
}

.bottom-nav-item .icon {
  font-size: 16px;
}

.commandbar {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 60px;
}

.commandbar-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.75);
}

.commandbar-dialog {
  position: relative;
  z-index: 10;
  max-width: 480px;
  width: 100%;
}

.commandbar-header {
  padding-bottom: 8px;
}

.commandbar-input {
  width: 100%;
  border: none;
  outline: none;
  border-radius: 999px;
  padding: 8px 14px;
  background: rgba(15, 23, 42, 0.95);
  color: var(--nyvron-text-main);
}

.commandbar-footer {
  font-size: 10px;
  display: flex;
  justify-content: space-between;
  color: var(--nyvron-text-muted);
  margin-top: 6px;
}

/* =========================
   Responsive
   ========================= */

@media (max-width: 768px) {
  .sidebar {
    display: none;
  }

  .screens {
    padding: 12px 12px 80px;
  }

  .topbar {
    margin: 8px 12px 0;
  }

  .bottom-nav {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    align-items: center;
    justify-content: space-around;
    backdrop-filter: blur(20px);
    background: rgba(15, 23, 42, 0.92);
    border-top: 1px solid rgba(148, 163, 184, 0.25);
  }

  .chat-layout,
  .calendar-layout {
    grid-template-columns: 1fr;
  }

  .chat-side {
    order: -1;
  }
}