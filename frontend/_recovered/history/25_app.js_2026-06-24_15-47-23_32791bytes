    document.documentElement.style.setProperty(
      "--nyvron-font-scale",
      factor
    );
    const s = loadJSON(STORAGE_KEYS.settings, {});
    s.fontScale = factor;
    saveJSON(STORAGE_KEYS.settings, s);
  });
}

// ========== Command bar ==========
const commandBar = document.getElementById("commandbar");
const commandBarTrigger = document.getElementById("commandbar-trigger");
const commandBarInput = document.getElementById("commandbar-input");

function openCommandBar() {
  if (!commandBar) return;
  commandBar.classList.remove("hidden");
  commandBar.setAttribute("aria-hidden", "false");
  if (commandBarInput) {
    commandBarInput.value = "";
    commandBarInput.focus();
  }
}

function closeCommandBar() {
  if (!commandBar) return;
  commandBar.classList.add("hidden");
  commandBar.setAttribute("aria-hidden", "true");
}

if (commandBarTrigger) {
  commandBarTrigger.addEventListener("click", openCommandBar);
}

document.addEventListener("keydown", (e) => {
  const key = e.key.toLowerCase();
  if ((e.metaKey || e.ctrlKey) && key === "k") {
    e.preventDefault();
    openCommandBar();
  }
  if (key === "escape") {
    closeCommandBar();
  }
});

if (commandBar) {
  commandBar.addEventListener("click", (e) => {
    if (e.target.classList.contains("commandbar-backdrop")) {
      closeCommandBar();
    }
  });
}

