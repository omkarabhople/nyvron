// Countdown
const countdownSetBtn = document.getElementById("countdown-set-btn");
const countdownLabelEl = document.getElementById("countdown-label");
const countdownTimeEl = document.getElementById("countdown-time");
const countdownMetaEl = document.getElementById("countdown-meta");
let countdownTimer = null;

function renderCountdown() {
  if (!todayState.countdown) {
    if (countdownLabelEl) countdownLabelEl.textContent = "";
    if (countdownTimeEl) countdownTimeEl.textContent = "";
    if (countdownMetaEl) countdownMetaEl.textContent = "";
    return;
  }

  const target = new Date(todayState.countdown.target);
  const now = new Date();
  const diffMs = target.getTime() - now.getTime();
  if (diffMs <= 0) {
    if (countdownTimeEl) countdownTimeEl.textContent = "0 days";
    return;
  }
  const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  const hours = Math.floor(
    (diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
  );
  const mins = Math.floor(
    (diffMs % (1000 * 60 * 60)) / (1000 * 60)
  );
  if (countdownLabelEl)
    countdownLabelEl.textContent = todayState.countdown.label;
  if (countdownTimeEl)
    countdownTimeEl.textContent = `${days}d ${hours}h ${mins}m`;
  if (countdownMetaEl)
    countdownMetaEl.textContent = `Target: ${target.toLocaleDateString(
      "en-IN"
    )}`;
}

function startCountdownInterval() {
  if (!todayState.countdown) return;
  if (countdownTimer) clearInterval(countdownTimer);
  countdownTimer = setInterval(renderCountdown, 60 * 1000);
  renderCountdown();
}

if (countdownSetBtn) {
  countdownSetBtn.addEventListener("click", () => {
    const label = prompt("Countdown label (e.g., Exam, Project end)");
    if (!label) return;
    const dateStr = prompt("Target date (YYYY-MM-DD)");
    if (!dateStr) return;
    const target = new Date(dateStr);
    if (Number.isNaN(target.getTime())) return;
    todayState.countdown = { label, target: target.toISOString() };
    saveJSON(STORAGE_KEYS.today, todayState);
    startCountdownInterval();
  });
}
if (todayState.countdown) startCountdownInterval();

