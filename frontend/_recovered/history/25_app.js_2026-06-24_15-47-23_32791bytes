// --- Storage helpers ---
const STORAGE_KEYS = {
  today: "nyvron_today",
  calendar: "nyvron_calendar",
  timer: "nyvron_timer",
  schedule: "nyvron_schedule",
  memory: "nyvron_memory",
  reflection: "nyvron_reflection",
  settings: "nyvron_settings",
  profile: "nyvron_profile",
};

function loadJSON(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return fallback;
    return JSON.parse(raw);
  } catch (_) {
    return fallback;
  }
}

function saveJSON(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch (_) {}
}

// ========== Screen navigation ==========
const screenEls = document.querySelectorAll(".screen");
const navButtons = document.querySelectorAll("[data-screen-target]");
const topbarTitle = document.getElementById("topbar-title");

function showScreen(screenId) {
  screenEls.forEach((screen) => {
    screen.classList.toggle("active", screen.id === screenId);
  });

  navButtons.forEach((btn) => {
    const target = btn.getAttribute("data-screen-target");
    btn.classList.toggle("active", target === screenId);
  });

  if (topbarTitle) {
    const name = screenId.replace("screen-", "").replace("-", " ");
    topbarTitle.textContent =
      name.charAt(0).toUpperCase() + name.slice(1);
  }
}

navButtons.forEach((btn) => {
  btn.addEventListener("click", () => {
    const target = btn.getAttribute("data-screen-target");
    if (target) showScreen(target);
  });
});

showScreen("screen-today");

// ========== Clock & greeting ==========
function updateTopbarClock() {
  const now = new Date();
  const clockEl = document.getElementById("topbar-clock");
  const todayTimeEl = document.getElementById("today-time");
  const dashboardTimeEl = document.getElementById("dashboard-time");

  const hh = String(now.getHours()).padStart(2, "0");
  const mm = String(now.getMinutes()).padStart(2, "0");
  const ss = String(now.getSeconds()).padStart(2, "0");
  const timeString = `${hh}:${mm}:${ss}`;

  if (clockEl) clockEl.textContent = timeString;
  if (todayTimeEl) todayTimeEl.textContent = timeString;
  if (dashboardTimeEl) dashboardTimeEl.textContent = timeString;

  const todayDateEl = document.getElementById("today-date");
  const dashboardDateEl = document.getElementById("dashboard-date");
  const dateStr = now.toLocaleDateString("en-IN", {
    weekday: "long",
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
  if (todayDateEl) todayDateEl.textContent = dateStr;
  if (dashboardDateEl) dashboardDateEl.textContent = dateStr;
}
setInterval(updateTopbarClock, 1000);
updateTopbarClock();

function updateGreeting() {
  const greetingEl = document.getElementById("today-greeting");
  const subtitleEl = document.getElementById("today-subtitle");
  const dashboardGreeting = document.getElementById("dashboard-greeting");

  const now = new Date();
  const hour = now.getHours();
  let greeting = "HELLO! SIR!";
  let line = "Let’s build your empire.";

  if (hour < 12) {
    greeting = "GOOD MORNING";
    line = "Start your day with intent.";
  } else if (hour < 18) {
    greeting = "GOOD AFTERNOON";
    line = "Keep your momentum going.";
  } else {
    greeting = "GOOD EVENING";
    line = "Reflect and reset for tomorrow.";
  }

  if (greetingEl) greetingEl.textContent = greeting;
  if (subtitleEl) subtitleEl.textContent = line;
  if (dashboardGreeting) dashboardGreeting.textContent = greeting;
}
updateGreeting();

// ========== Theme ==========
const themeToggleBtn = document.getElementById("theme-toggle-btn");
const settingsThemeSelect = document.getElementById(
  "settings-theme-select"
);

function getCurrentTheme() {
  return document.documentElement.getAttribute("data-theme") || "dark";
}

function applyThemeFromSettings() {
  const settings = loadJSON(STORAGE_KEYS.settings, {});
  const mode = settings.theme || "dark";
  document.documentElement.setAttribute("data-theme", mode);
  if (settingsThemeSelect) {
    settingsThemeSelect.value = settings.theme || "dark";
  }
}

function setTheme(theme) {
  document.documentElement.setAttribute("data-theme", theme);
  const settings = loadJSON(STORAGE_KEYS.settings, {});
  settings.theme = theme;
  saveJSON(STORAGE_KEYS.settings, settings);
}

function toggleTheme() {
  const current = getCurrentTheme();
  setTheme(current === "dark" ? "light" : "dark");
}

if (themeToggleBtn) {
  themeToggleBtn.addEventListener("click", toggleTheme);
}
if (settingsThemeSelect) {
  settingsThemeSelect.addEventListener("change", (e) => {
    const value = e.target.value;
    if (value === "auto") {
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;
      setTheme(prefersDark ? "dark" : "light");
    } else {
      setTheme(value);
    }
  });
}
applyThemeFromSettings();

