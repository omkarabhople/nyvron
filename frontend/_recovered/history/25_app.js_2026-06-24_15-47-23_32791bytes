const calendarState = loadJSON(STORAGE_KEYS.calendar, {
  events: [], // {id, date, time, title, type, notes}
});

const calendarGrid = document.getElementById("calendar-days-grid");
const calendarCurrentLabel = document.getElementById(
  "calendar-current-label"
);
const calendarPrevBtn = document.getElementById("calendar-prev-btn");
const calendarNextBtn = document.getElementById("calendar-next-btn");
const calendarSelectedDate = document.getElementById(
  "calendar-selected-date"
);
const calendarEventsList = document.getElementById(
  "calendar-events-list"
);

let calYear, calMonth, selectedDateISO;

function initCalendarToday() {
  const now = new Date();
  calYear = now.getFullYear();
  calMonth = now.getMonth();
  selectedDateISO = now.toISOString().slice(0, 10); // YYYY-MM-DD
}

function renderCalendarGrid() {
  if (!calendarGrid || !calendarCurrentLabel) return;
  calendarGrid.innerHTML = "";

  const first = new Date(calYear, calMonth, 1);
  const firstDay = (first.getDay() + 6) % 7; // Monday=0
  const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();

  const monthName = first.toLocaleString("en-US", { month: "long" });
  calendarCurrentLabel.textContent = `${monthName} ${calYear}`;

  // fill empties
  for (let i = 0; i < firstDay; i++) {
    const empty = document.createElement("div");
    empty.className = "calendar-day empty";
    calendarGrid.appendChild(empty);
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const cell = document.createElement("button");
    cell.className = "calendar-day";
    cell.textContent = d;
    const dateISO = new Date(calYear, calMonth, d)
      .toISOString()
      .slice(0, 10);

    if (dateISO === selectedDateISO) {
      cell.classList.add("selected");
    }

    cell.addEventListener("click", () => {
      selectedDateISO = dateISO;
      renderCalendarGrid();
      renderCalendarDayDetails();
    });

    calendarGrid.appendChild(cell);
  }
}

function renderCalendarDayDetails() {
  if (!calendarSelectedDate || !calendarEventsList) return;
  const dateObj = new Date(selectedDateISO);
  const label = dateObj.toLocaleDateString("en-IN", {
    weekday: "long",
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
  calendarSelectedDate.textContent = label;

  const eventsForDay = calendarState.events.filter(
    (e) => e.date === selectedDateISO
  );
  calendarEventsList.innerHTML = "";
  if (!eventsForDay.length) {
    const li = document.createElement("li");
    li.textContent = "No events yet.";
    calendarEventsList.appendChild(li);
    return;
  }
  eventsForDay.forEach((ev) => {
    const li = document.createElement("li");
    li.textContent = `${ev.time || "--:--"} · ${ev.title} (${ev.type})`;
    calendarEventsList.appendChild(li);
  });
}

if (calendarPrevBtn) {
  calendarPrevBtn.addEventListener("click", () => {
    calMonth -= 1;
    if (calMonth < 0) {
      calMonth = 11;
      calYear -= 1;
    }
    renderCalendarGrid();
  });
}

if (calendarNextBtn) {
  calendarNextBtn.addEventListener("click", () => {
    calMonth += 1;
    if (calMonth > 11) {
      calMonth = 0;
      calYear += 1;
    }
    renderCalendarGrid();
  });
}

