      seconds: elapsedSeconds,
      time: timerDisplay ? timerDisplay.textContent : "",
      mode: currentMode,
      name,
      tags,
      date: new Date().toISOString().slice(0, 10),
    });
    saveJSON(STORAGE_KEYS.timer, timerState);
    renderSessions();
    resetTimer();
    if (timerSessionName) timerSessionName.value = "";
    if (timerTagsInput) timerTagsInput.value = "";
  });
}
renderSessions();

// ========== Schedule ==========
const scheduleState = loadJSON(STORAGE_KEYS.schedule, {
  day: [],
  week: [],
  month: [],
});

const scheduleDayList = document.getElementById("schedule-day-list");
const scheduleWeekList = document.getElementById("schedule-week-list");
const scheduleMonthList = document.getElementById(
  "schedule-month-list"
);
const scheduleNewBlockBtn = document.getElementById(
  "schedule-new-block-btn"
);

function renderScheduleList(list, container) {
  if (!container) return;
  container.innerHTML = "";
  list.forEach((item, idx) => {
    const li = document.createElement("li");
    li.textContent = item;
    li.addEventListener("click", () => {
      list.splice(idx, 1);
      saveJSON(STORAGE_KEYS.schedule, scheduleState);
      renderScheduleAll();
    });
    container.appendChild(li);
  });
}

function renderScheduleAll() {
  renderScheduleList(scheduleState.day, scheduleDayList);
  renderScheduleList(scheduleState.week, scheduleWeekList);
  renderScheduleList(scheduleState.month, scheduleMonthList);
}

if (scheduleNewBlockBtn) {
  scheduleNewBlockBtn.addEventListener("click", () => {
    const block = prompt("New block (time + label)");
    if (!block) return;
    scheduleState.day.push(block);
    saveJSON(STORAGE_KEYS.schedule, scheduleState);
    renderScheduleAll();
  });
}
renderScheduleAll();

// ========== Memory ==========
const memoryState = loadJSON(STORAGE_KEYS.memory, {
  items: [],
});

const memoryTitleInput = document.getElementById("memory-title-input");
const memoryBodyInput = document.getElementById("memory-body-input");
const memorySaveBtn = document.getElementById("memory-save-btn");
const memoryListEl = document.getElementById("memory-list");

function renderMemory() {
  if (!memoryListEl) return;
  memoryListEl.innerHTML = "";
  memoryState.items.forEach((m, idx) => {
    const li = document.createElement("li");
    li.textContent = `${m.title} – ${m.body}`;
    li.addEventListener("click", () => {
      memoryState.items.splice(idx, 1);
      saveJSON(STORAGE_KEYS.memory, memoryState);
      renderMemory();
    });
    memoryListEl.appendChild(li);
  });
}

if (memorySaveBtn) {
  memorySaveBtn.addEventListener("click", () => {
    const title =
      (memoryTitleInput && memoryTitleInput.value.trim()) ||
      "Untitled";
    const body =
      (memoryBodyInput && memoryBodyInput.value.trim()) || "";
    if (!body) return;
    memoryState.items.push({ title, body });
    saveJSON(STORAGE_KEYS.memory, memoryState);
    if (memoryTitleInput) memoryTitleInput.value = "";
    if (memoryBodyInput) memoryBodyInput.value = "";
    renderMemory();
  });
}
renderMemory();

// ========== Reflection ==========
const reflectionState = loadJSON(STORAGE_KEYS.reflection, {
  entries: [],
});

const reflectionInput = document.getElementById("reflection-input");
const reflectionSaveBtn = document.getElementById(
  "reflection-save-btn"
);
const reflectionListEl = document.getElementById(
  "reflection-entries-list"
);

function renderReflections() {
  if (!reflectionListEl) return;
  reflectionListEl.innerHTML = "";
  reflectionState.entries.forEach((r, idx) => {
    const li = document.createElement("li");
    li.textContent = `${r.date}: ${r.text}`;
    li.addEventListener("click", () => {
      reflectionState.entries.splice(idx, 1);
      saveJSON(STORAGE_KEYS.reflection, reflectionState);
      renderReflections();
    });
    reflectionListEl.appendChild(li);
  });
}

if (reflectionSaveBtn) {
  reflectionSaveBtn.addEventListener("click", () => {
    if (!reflectionInput) return;
    const text = reflectionInput.value.trim();
    if (!text) return;
    reflectionState.entries.push({
      date: new Date().toISOString().slice(0, 10),
      text,
    });
    saveJSON(STORAGE_KEYS.reflection, reflectionState);
    reflectionInput.value = "";
    renderReflections();
  });
}
renderReflections();

// ========== Profile & logo ==========
const profileState = loadJSON(STORAGE_KEYS.profile, {
  name: "User",
  avatarDataUrl: null,
});

const profileNameEl = document.getElementById("profile-name");
const profileAvatarCircle = document.getElementById(
  "profile-avatar-circle"
);
const profileAvatarUpload = document.getElementById(
  "profile-avatar-upload"
);
const settingsLogoInput = document.getElementById(
  "settings-logo-input"
);

function renderProfile() {
  if (profileNameEl) profileNameEl.textContent = profileState.name;
  if (profileAvatarCircle) {
    if (profileState.avatarDataUrl) {
      profileAvatarCircle.style.backgroundImage = `url(${profileState.avatarDataUrl})`;
      profileAvatarCircle.style.backgroundSize = "cover";
      profileAvatarCircle.textContent = "";
    } else {
      profileAvatarCircle.style.backgroundImage = "";
      profileAvatarCircle.textContent =
        profileState.name.charAt(0).toUpperCase();
    }
  }
}

function handleAvatarFile(file) {
  const reader = new FileReader();
  reader.onload = (e) => {
    profileState.avatarDataUrl = e.target.result;
    saveJSON(STORAGE_KEYS.profile, profileState);
    renderProfile();
  };
  reader.readAsDataURL(file);
}

if (profileAvatarUpload) {
  profileAvatarUpload.addEventListener("click", () => {
    if (!settingsLogoInput) {
      alert("Use Settings → Theme & UI → NYVRON logo to upload.");
    }
  });
}

if (settingsLogoInput) {
  settingsLogoInput.addEventListener("change", (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    handleAvatarFile(file);
  });
}
renderProfile();

// ========== Settings: toggles ==========
const rememberChatsCheckbox = document.getElementById(
  "settings-remember-chats"
);
const storeHistoryCheckbox = document.getElementById(
  "settings-store-history"
);
const autoArchiveCheckbox = document.getElementById(
  "settings-auto-archive"
);
const settingsClearMemoryBtn = document.getElementById(
  "settings-clear-memory-btn"
);
const settingsForgetAllBtn = document.getElementById(
  "settings-forget-all-btn"
);

const settingsState = loadJSON(STORAGE_KEYS.settings, {});

function applySettingsToUI() {
  if (rememberChatsCheckbox)
    rememberChatsCheckbox.checked = !!settingsState.rememberChats;
  if (storeHistoryCheckbox)
    storeHistoryCheckbox.checked = !!settingsState.storeHistory;
  if (autoArchiveCheckbox)
    autoArchiveCheckbox.checked = !!settingsState.autoArchive;
}
applySettingsToUI();

function saveSettings() {
  saveJSON(STORAGE_KEYS.settings, settingsState);
}

if (rememberChatsCheckbox) {
  rememberChatsCheckbox.addEventListener("change", (e) => {
    settingsState.rememberChats = e.target.checked;
    saveSettings();
  });
}
if (storeHistoryCheckbox) {
  storeHistoryCheckbox.addEventListener("change", (e) => {
    settingsState.storeHistory = e.target.checked;
    saveSettings();
  });
}
if (autoArchiveCheckbox) {
  autoArchiveCheckbox.addEventListener("change", (e) => {
    settingsState.autoArchive = e.target.checked;
    saveSettings();
  });
}

if (settingsClearMemoryBtn) {
  settingsClearMemoryBtn.addEventListener("click", () => {
    if (!confirm("Clear all memory (Memory screen only)?")) return;
    memoryState.items = [];
    saveJSON(STORAGE_KEYS.memory, memoryState);
    renderMemory();
  });
}
if (settingsForgetAllBtn) {
  settingsForgetAllBtn.addEventListener("click", () => {
    if (
      !confirm(
        "Forget everything (today, calendar, timer, memory, reflection, schedule)?"
      )
    )
      return;
    Object.values(STORAGE_KEYS).forEach((key) => {
      localStorage.removeItem(key);
    });
    window.location.reload();
  });
}