            <span class="label">Calendar</span>
          </button>
          <button
            type="button"
            class="bottom-nav-item"
            data-screen-target="screen-settings"
          >
            <span class="icon">⚙️</span>
            <span class="label">Settings</span>
          </button>
        </nav>

        <!-- COMMAND BAR -->
        <div
          id="commandbar"
          class="commandbar hidden"
          aria-hidden="true"
        >
          <div class="commandbar-backdrop"></div>
          <div class="commandbar-dialog glass-card">
            <div class="commandbar-header">
              <input
                id="commandbar-input"
                type="text"
                class="commandbar-input"
                placeholder="Type a command or search (e.g., 'Go to Today', 'Start timer')"
              />
            </div>
            <div
              id="commandbar-results"
              class="commandbar-results"
            ></div>
            <div class="commandbar-footer">
              <span>Enter · Run</span>
              <span>Esc · Close</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="app.js"></script>
  </body>
</html>