<!DOCTYPE html>
html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>NYVRON</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div id="app-root" class="app">
      <!-- SIDEBAR -->
      <nav class="sidebar glass-sidebar">
        <div class="sidebar-brand glass-card">
          <div class="logo ios-pill" id="app-logo">
            N
          </div>
          <div class="brand-text">
            <span class="name">NYVRON</span>
            <span class="subtext">Personal OS</span>
          </div>
        </div>

        <div class="sidebar-nav">
          <div class="sidebar-section-label">Main</div>
          <button
            class="nav-item active"
            data-screen-target="screen-today"
            type="button"
          >
            <span class="icon">☀️</span>
            <span>Today</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-dashboard"
            type="button"
          >
            <span class="icon">🏠</span>
            <span>Dashboard</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-chat"
            type="button"
          >
            <span class="icon">💬</span>
            <span>Chat</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-calendar"
            type="button"
          >
            <span class="icon">📅</span>
            <span>Calendar</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-time-tracking"
            type="button"
          >
            <span class="icon">⏱️</span>
            <span>Time Tracker</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-schedule"
            type="button"
          >
            <span class="icon">📋</span>
            <span>Schedule</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-memory"
            type="button"
          >
            <span class="icon">🧠</span>
            <span>Memory</span>
          </button>

          <div class="sidebar-section-label">Insights</div>
          <button
            class="nav-item"
            data-screen-target="screen-reports"
            type="button"
          >
            <span class="icon">📊</span>
            <span>Reports</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-analytics"
            type="button"
          >
            <span class="icon">📈</span>
            <span>Analytics</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-reflection"
            type="button"
          >
            <span class="icon">📝</span>
            <span>Reflection</</button>

          <div class="sidebar-section-label">System</div>
          <button
            class="nav-item"
            data-screen-target="screen-profile"
            type="button"
          >
            <span class="icon">👤</span>
            <span>Profile</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-notifications"
            type="button"
          >
            <span class="icon">🔔</span>
            <span>Notifications</span>
          </button>
          <button
            class="nav-item"
            data-screen-target="screen-settings"
            type="button"
          >
            <span class="icon">⚙️</span>
            <span>Settings</span>
          </button>
        </div>

        <div class="sidebar-footer glass-card">
          <div class="status">
            <span class="status-indicator">
              <span class="status-dot"></span>
              <span class="status-ring"></span>
            </span>
            <span id="ai-status-label">Online · Local</span>
          </div>
          <div class="text-xs text-dim">
            Mumbai · GMT+5:30
          </div>
        </div>
      </nav>

      <!-- MAIN PANEL -->
      <div class="main glass-main">
        <!-- TOPBAR -->
        <header class="topbar glass-toolbar">
          <div class="topbar-left">
            <div id="topbar-title" class="topbar-title">
              Today
            </div>
            <div class="topbar-subtitle">
              Personal OS for OMKAR
            </div>
          </div>

          <div class="topbar-center">
            <div class="topbar-clock">
              <span id="topbar-clock" class="topbar-clock-time">
                --:--:--
              </span>
              <span class="topbar-clock-zone">
                Mumbai · GMT+5:30
              </span>
            </div>
          </div>

          <div class="topbar-right">
            <button
              id="commandbar-trigger"
              class="topbar-search glass-button"
              type="button"
            >
              <span class="icon">🔍</span>
              <span>Search</span>
              <kbd>⌘K</kbd>
            </button>

            <button
              id="theme-toggle-btn"
              class="topbar-icon-btn glass-button"
              type="button"
              aria-label="Toggle theme"
            >
              ◐
            </button>
          </div>
        </header>

        <!-- OFFLINE BADGE -->
        <div id="offline-badge" class="offline-badge glass-card hidden">
          <span class="icon">⚠️</span>
          <span>NYVRON is offline — working in local-only mode.</span>
        </div>

        <!-- SCREENS -->
        <main id="screens" class="screens">
          <!-- TODAY -->
          <section id="screen-today" class="screen active">
            <div class="screen-inner">
              <div class="today-header glass-card">
                <div class="today-header-main">
                  <div class="today-status-pill">
                    <div class="status-ellipse">
                      <span class="status-dot-green"></span>
                    </div>
                    <span class="status-text">
                      Online · Mumbai, India
                    </span>
                  </div>

                  <h1 id="today-greeting" class="today-greeting">
                    HELLO! SIR!
                  </h1>

                  <p id="today-subtitle" class="today-subtitle">
                    Good morning · Let’s build your empire.
                  </p>
                </div>

                <div class="today-header-time">
                  <div class="today-time-wrap">
                    <span
                      id="today-time"
                      class="today-time-display"
                    >
                      --:--:--
                    </span>
                    <span
                      id="today-timezone"
                      class="today-timezone"
                    >
                      Mumbai, India · GMT+5:30
                    </span>
                  </div>
                  <div id="today-date" class="today-date">
                    <!-- JS sets date -->
                  </div>
                </div>
              </div>

              <div class="today-grid">
                <!-- Today energy -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      Today
                    </div>
                    <div class="card-subtitle">
                      Energy & focus
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="today-energy-row">
                      <div class="today-energy-label">
                        Energy
                      </div>
                      <div id="energy-selector" class="energy-selector">
                        <button
                          type="button"
                          class="energy-btn glass-chip active"
                          data-energy="high"
                        >
                          ⚡ High
                        </button>
                        <button
                          type="button"
                          class="energy-btn glass-chip"
                          data-energy="medium"
                        >
                          🔋 Medium
                        </button>
                        <button
                          type="button"
                          class="energy-btn glass-chip"
                          data-energy="low"
                        >
                          🪫 Low
                        </button>
                      </div>
                    </div>

                    <div class="today-mode-row">
                      <div class="today-label">
                        Mode
                      </div>
                      <div class="today-mode-values">
                        <div
                          id="today-mode-primary"
                          class="today-mode-primary"
                        ></div>
                        <div
                          id="today-mode-secondary"
                          class="today-mode-secondary"
                        ></div>
                      </div>
                    </div>

                    <div
                      id="low-energy-banner"
                      class="low-energy-banner glass-pill hidden"
                    >
                      <div class="low-energy-icon">
                        🪫
                      </div>
                      <div class="low-energy-text">
                        Low energy mode enabled. Notifications reduced,
                        schedule simplified.
                      </div>
                      <button
                        id="low-energy-dismiss"
                        type="button"
                        class="low-energy-dismiss"
                      >
                        Dismiss
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Priorities & Reminders -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      Priorities & Reminders
                    </div>
                    <button
                      type="button"
                      id="today-add-priority"
                      class="card-action-btn glass-button"
                    >
                      + Add
                    </button>
                  </div>
                  <div class="card-body">
                    <div class="list-section-label">
                      Today’s priorities
                    </div>
                    <ul id="today-priorities" class="checklist"></ul>

                    <div class="list-section-label">
                      Reminders
                    </div>
                    <ul id="today-reminders" class="checklist"></ul>
                  </div>
                </div>

                <!-- Today’s schedule -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      Today’s Schedule
                    </div>
                    <button
                      type="button"
                      id="today-add-schedule"
                      class="card-action-btn glass-button"
                    >
                      + Add
                    </button>
                  </div>
                  <div class="card-body">
                    <ul
                      id="today-schedule-list"
                      class="schedule-list"
                    ></ul>
                  </div>
                </div>

                <!-- Quick notes -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      Quick Notes
                    </div>
                  </div>
                  <div class="card-body">
                    <textarea
                      id="quick-notes-input"
                      class="quick-notes-input"
                      placeholder="Drop quick thoughts, ideas, or tasks here..."
                    ></textarea>
                    <button
                      type="button"
                      id="quick-notes-save"
                      class="glass-button"
                    >
                      Save note
                    </button>
                    <div
                      id="quick-notes-list"
                      class="quick-notes-list"
                    ></div>
                  </div>
                </div>

                <!-- Countdown -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      Countdown
                    </div>
                    <button
                      type="button"
                      id="countdown-set-btn"
                      class="card-action-btn glass-button"
                    >
                      + Add
                    </button>
                  </div>
                  <div class="card-body">
                    <div
                      id="countdown-label"
                      class="countdown-label"
                    ></div>
                    <div
                      id="countdown-time"
                      class="countdown-time"
                    ></div>
                    <div
                      id="countdown-meta"
                      class="countdown-meta"
                    ></div>
                  </div>
                </div>

                <!-- North Star -->
                <div class="card glass-card today-card">
                  <div class="card-header">
                    <div class="card-title">
                      North Star
                    </div>
                    <button
                      type="button"
                      id="northstar-edit-btn"
                      class="card-action-btn glass-button"
                    >
                      Edit
                    </button>
                  </div>
                  <div class="card-body">
                    <div class="northstar-section">
                      <div class="northstar-label">
                        Current phase
                      </div>
                      <div
                        id="northstar-phase"
                        class="northstar-phase"
                      ></div>
                    </div>
                    <div class="northstar-section">
                      <div class="northstar-label">
                        Direction
                      </div>
                      <div
                        id="northstar-direction"
                        class="northstar-direction"
                      ></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- DASHBOARD -->
          <section id="screen-dashboard" class="screen">
            <div class="screen-inner">
              <div class="dashboard-header glass-card">
                <div class="dashboard-header-main">
                  <h1
                    id="dashboard-greeting"
                    class="dashboard-greeting"
                  >
                    GOOD MORNING
                  </h1>
                  <h3
                    id="dashboard-date"
                    class="dashboard-date"
                  ></h3>
                </div>
                <div class="dashboard-header-time">
                  <div class="dashboard-time-label">
                    Mumbai · GMT+5:30
                  </div>
                  <div
                    id="dashboard-time"
                    class="dashboard-time"
                  >
                    --:--:--
                  </div>
                </div>
              </div>

              <div class="dashboard-grid">
                <!-- Upcoming -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Upcoming
                    </div>
                    <button
                      type="button"
                      class="card-action-btn glass-button"
                    >
                      View all
                    </button>
                  </div>
                  <div
                    id="dashboard-upcoming"
                    class="card-body"
                  ></div>
                </div>

                <!-- Deadlines -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Deadlines
                    </div>
                    <button
                      type="button"
                      id="dashboard-add-deadline"
                      class="card-action-btn glass-button"
                    >
                      + Add
                    </button>
                  </div>
                  <div
                    id="dashboard-deadlines"
                    class="card-body"
                  ></div>
                </div>

                <!-- Today’s Focus -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Today’s Focus
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="focus-chips">
                      <button
                        type="button"
                        class="focus-chip glass-chip"
                        data-focus="study"
                      >
                        📚 Study
                      </button>
                      <button
                        type="button"
                        class="focus-chip glass-chip"
                        data-focus="work"
                      >
                        💼 Work
                      </button>
                      <button
                        type="button"
                        class="focus-chip glass-chip"
                        data-focus="relax"
                      >
                        ☕ Relax
                      </button>
                      <button
                        type="button"
                        class="focus-chip glass-chip"
                        data-focus="explore"
                      >
                        🧭 Explore
                      </button>
                    </div>
                    <div
                      id="dashboard-focus-notes"
                      class="focus-notes"
                    ></div>
                  </div>
                </div>

                <!-- Reminders -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Reminders
                    </div>
                    <button
                      type="button"
                      id="dashboard-add-reminder"
                      class="card-action-btn glass-button"
                    >
                      + Add
                    </button>
                  </div>
                  <div
                    id="dashboard-reminders"
                    class="card-body"
                  ></div>
                </div>

                <!-- Progress -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Progress
                    </div>
                  </div>
                  <div class="card-body">
                    <div
                      id="dashboard-progress-chart"
                      class="progress-chart"
                    >
                      Time by mode (hooked to Reports)
                    </div>
                    <div
                      id="dashboard-progress-meta"
                      class="progress-meta"
                    ></div>
                  </div>
                </div>

                <!-- This week -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      This Week
                    </div>
                  </div>
                  <div
                    id="dashboard-week"
                    class="card-body"
                  ></div>
                </div>

                <!-- Reflection -->
                <div class="card glass-card dash-card">
                  <div class="card-header">
                    <div class="card-title">
                      Reflection
                    </div>
                    <button
                      type="button"
                      class="card-action-btn glass-button"
                      data-screen-target="screen-reflection"
                    >
                      Open
                    </button>
                  </div>
                  <div
                    id="dashboard-reflection"
                    class="card-body"
                  ></div>
                </div>
              </div>
            </div>
          </section>

          <!-- CHAT -->
          <section id="screen-chat" class="screen">
            <div class="screen-inner chat-screen">
              <div class="chat-header glass-card">
                <div class="chat-header-main">
                  <h1 class="chat-title">
                    Chat
                  </h1>
                  <p class="chat-subtitle">
                    Talk to NYVRON · Plan, reflect, debug your day.
                  </p>
                </div>
                <div class="chat-header-modes">
                  <button
                    type="button"
                    class="chat-mode-btn glass-chip active"
                    data-chat-mode="chat"
                  >
                    💬 Chat
                  </button>
                  <button
                    type="button"
                    class="chat-mode-btn glass-chip"
                    data-chat-mode="observe"
                  >
                    👁 Observe
                  </button>
                </div>
              </div>

              <div class="chat-layout">
                <!-- Chat main -->
                <div class="chat-main glass-card">
                  <div
                    id="chat-messages"
                    class="chat-messages"
                  ></div>

                  <div
                    id="chat-thinking-status"
                    class="chat-thinking hidden"
                  >
                    <span class="dot dot-1"></span>
                    <span class="dot dot-2"></span>
                    <span class="dot dot-3"></span>
                    <span class="thinking-label">
                      NYVRON is thinking...
                    </span>
                  </div>

                  <div class="chat-input-bar">
                    <button
                      type="button"
                      class="chat-input-icon glass-button"
                      id="chat-attach-btn"
                      aria-label="Attach"
                    >
                      📎
                    </button>
                    <textarea
                      id="chat-input"
                      class="chat-input"
                      rows="1"
                      placeholder="Ask NYVRON anything…"
                    ></textarea>
                    <button
                      type="button"
                      id="chat-send-btn"
                      class="chat-send-btn glass-button"
                    >
                      ➤
                    </button>
                  </div>
                </div>

                <!-- Chat side -->
                <aside class="chat-side glass-card">
                  <div class="chat-side-section">
                    <div class="card-header">
                      <div class="card-title">
                        Quick actions
                      </div>
                    </div>
                    <div class="chat-quick-actions">
                      <button
                        type="button"
                        class="glass-chip"
                        data-quick-prompt="Plan my day"
                      >
                        Plan my day
                      </button>
                      <button
                        type="button"
                        class="glass-chip"
                        data-quick-prompt="What is pending today?"
                      >
                        What is pending?
                      </button>
                      <button
                        type="button"
                        class="glass-chip"
                        data-quick-prompt="Summarize today"
                      >
                        Summarize today
                      </button>
                      <button
                        type="button"
                        class="glass-chip"
                        data-quick-prompt="Reflect on this week"
                      >
                        Reflect on this week
                      </button>
                    </div>
                  </div>

                  <div class="chat-side-section">
                    <div class="card-header">
                      <div class="card-title">
                        Observe
                      </div>
                    </div>
                    <div
                      id="chat-observe-summary"
                      class="observe-summary"
                    ></div>
                    <div
                      id="chat-observe-state"
                      class="observe-state"
                    ></div>
                  </div>

                  <div class="chat-side-section">
                    <div class="card-header">
                      <div class="card-title">
                        Memory
                      </div>
                    </div>
                    <div class="chat-memory-actions">
                      <button
                        type="button"
                        class="glass-button"
                        id="chat-save-memory-btn"
                      >
                        Save to memory
                      </button>
                      <button
                        type="button"
                        class="glass-button"
                        id="chat-open-memory-btn"
                        data-screen-target="screen-memory"
                      >
                        Open memory
                      </button>
                    </div>
                  </div>
                </aside>
              </div>
            </div>
          </section>

          <!-- CALENDAR -->
          <section id="screen-calendar" class="screen">
            <div class="screen-inner">
              <div class="calendar-header glass-card">
                <div class="calendar-header-main">
                  <h1 class="calendar-title">
                    Calendar
                  </h1>
                  <p class="calendar-subtitle">
                    2026–2032 · Events, reminders, and work blocks.
                  </p>
                </div>
                <div class="calendar-header-actions">
                  <div class="calendar-view-toggle">
                    <button
                      type="button"
                      class="glass-chip active"
                      data-calendar-view="month"
                    >
                      Month
                    </button>
                    <button
                      type="button"
                      class="glass-chip"
                      data-calendar-view="week"
                    >
                      Week
                    </button>
                    <button
                      type="button"
                      class="glass-chip"
                      data-calendar-view="day"
                    >
                      Day
                    </button>
                  </div>
                  <button
                    type="button"
                    id="calendar-new-event-btn"
                    class="glass-button"
                  >
                    + New event
                  </button>
                </div>
              </div>

              <div class="calendar-layout">
                <!-- Calendar grid -->
                <div class="calendar-grid glass-card">
                  <div class="calendar-grid-header">
                    <button
                      type="button"
                      id="calendar-prev-btn"
                      class="glass-button"
                    >
                      ‹
                    </button>
                    <div
                      id="calendar-current-label"
                      class="calendar-current-label"
                    >
                      <!-- e.g., June 2026 -->
                    </div>
                    <button
                      type="button"
                      id="calendar-next-btn"
                      class="glass-button"
                    >
                      ›
                    </button>
                  </div>

                  <div class="calendar-weekdays">
                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>
                    <span>Sat</span>
                    <span>Sun</span>
                  </div>

                  <div
                    id="calendar-days-grid"
                    class="calendar-days-grid"
                  >
                    <!-- date cells generated by JS -->
                  </div>
                </div>

                <!-- Calendar details -->
                <div class="calendar-detail glass-card">
                  <div class="card-header">
                    <div class="card-title">
                      Day details
                    </div>
                    <div
                      id="calendar-selected-date"
                      class="calendar-selected-date"
                    >
                      <!-- filled by JS -->
                    </div>
                  </div>

                  <div class="calendar-detail-body">
                    <div class="list-section-label">
                      Events
                    </div>
                    <ul
                      id="calendar-events-list"
                      class="calendar-events-list"
                    ></ul>

                    <div class="list-section-label">
                      Quick add
                    </div>
                    <div class="calendar-quick-add">
                      <button
                        type="button"
                        class="glass-chip"
                        data-calendar-add-type="reminder"
                      >
                        Reminder
                      </button>
                      <button
                        type="button"
                        class="glass-chip"
                        data-calendar-add-type="work"
                      >
                        Work / Study
                      </button>
                      <button
                        type="button"
                        class="glass-chip"
                        data-calendar-add-type="other"
                      >
                        Other
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Calendar add event modal -->
              <div
                id="calendar-modal"
                class="modal hidden"
                aria-hidden="true"
              >
                <div class="modal-backdrop"></div>
                <div class="modal-dialog glass-card">
                  <div class="modal-header">
                    <div class="modal-title">
                      New event
                    </div>
                    <button
                      type="button"
                      id="calendar-modal-close"
                      class="modal-close-btn"
                    >
                      ✕
                    </button>
                  </div>
                  <div class="modal-body">
                    <label class="field">
                      <span class="field-label">
                        Title
                      </span>
                      <input
                        id="calendar-event-title"
                        type="text"
                        class="field-input"
                        placeholder="Event title"
                      />
                    </label>

                    <label class="field">
                      <span class="field-label">
                        Type
                      </span>
                      <select
                        id="calendar-event-type"
                        class="field-input"
                      >
                        <option value="reminder">
                          Reminder
                        </option>
